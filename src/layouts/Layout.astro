---
import { execFileSync } from 'node:child_process';
import { site } from '../content/site';
interface Props { title?: string; description?: string; noindex?: boolean }
const { title = site.seo.title, description = site.seo.description, noindex = false } = Astro.props;
const buildId = (process.env.CF_PAGES_COMMIT_SHA || execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim()).slice(0, 7);
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" style={{ '--primary': site.theme.primaryColor, '--accent': site.theme.accentColor, '--font': site.theme.font }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="build-id" content={buildId} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={site.favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(site.heroImage, Astro.site)} />
    <meta property="og:image:alt" content={site.heroImageAlt} />
  </head>
  <body>
    <a class="skip" href="#main">{site.labels.skipToContent}</a>
    <header><a class="brand" href={site.links.home}>{site.brandName}</a><a class="story-link" href={site.links.story}>{site.labels.story}</a></header>
    <slot />
    <footer>
      <div class="footer-top">
        <a class="footer-brand" href={site.links.home}>{site.brandName}</a>
        {Object.values(site.contact).some(Boolean) && <address>
          <p>{site.labels.contact}</p>
          {site.contact.email && <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>}
          {site.contact.instagram && <a href={site.contact.instagram}>{site.labels.instagram}</a>}
          {site.contact.phone && <a href={`tel:${site.contact.phone.replace(/[^+\d]/g, '')}`}>{site.contact.phone}</a>}
          {site.contact.address && <p>{site.contact.address}</p>}
          {site.contact.hours && <p>{site.contact.hours}</p>}
        </address>}
      </div>
      <div class="footer-bottom"><p>{site.footerNote}</p><p>© {new Date().getFullYear()} {site.brandName}</p></div>
    </footer>
  </body>
</html>
<style is:global>
  :root { --paper: #f6f2e8; --line: #243b2b38; font-family: var(--font); color: var(--primary); background: var(--paper); font-synthesis: none; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  a { color: inherit; text-underline-offset: .3em; }
  a:hover { color: var(--accent); }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
  p { font-size: 1.125rem; line-height: 1.65; margin: 0 0 1rem; }
  h1, h2, h3 { font-weight: 400; text-wrap: balance; }
  img { display: block; max-width: 100%; height: auto; }
  header { margin: 0 5%; padding: 1.75rem 0; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .brand { font-size: clamp(1.25rem, 2.5vw, 1.8rem); text-decoration: none; letter-spacing: -.04em; }
  .story-link { font-size: .9375rem; }
  .skip { position: absolute; top: -8rem; left: 1rem; background: var(--paper); padding: 1rem; z-index: 10; }
  .skip:focus { top: 1rem; }
  footer { background: var(--primary); color: var(--paper); padding: 3.5rem 5% 1.5rem; }
  footer a:hover { color: inherit; text-decoration: underline; }
  .footer-top { display: flex; justify-content: space-between; gap: 2rem; padding-bottom: 3rem; }
  .footer-brand { font-size: clamp(2rem, 5.8vw, 5rem); text-decoration: none; letter-spacing: -.045em; }
  address { font-style: normal; overflow-wrap: anywhere; }
  address a { display: block; margin-bottom: .65rem; }
  address p { white-space: pre-line; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid #ffffff45; padding-top: 1.5rem; }
  .footer-bottom p { font-size: .875rem; }
  @media (max-width: 600px) { .footer-top, .footer-bottom { flex-direction: column; } header { padding-block: 1.35rem; } }
</style>
