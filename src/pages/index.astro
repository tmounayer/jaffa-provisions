---
import Layout from '../layouts/Layout.astro';
import { site } from '../content/site';
---
<Layout>
  <main id="main">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">{site.tagline}</p>
        <h1>{site.headline}</h1>
        <div class="intro">{site.intro.map(paragraph => <p>{paragraph}</p>)}</div>
        <a class="text-link" href={site.links.story}>{site.labels.story}<span aria-hidden="true"> ↗</span></a>
      </div>
      <img class="hero-image" src={site.heroImage} alt={site.heroImageAlt} width="1536" height="1024" fetchpriority="high" />
    </section>
    <div class="sections" id="our-beginnings">
      {site.sections.map((section, index) => <section class:list={['section', { 'has-image': section.image, reverse: index % 2 === 1 }]}>
        <div class="section-copy">
          <span class="section-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h2>{section.title}</h2>
          <div class="section-body">{section.body.map(paragraph => <p>{paragraph}</p>)}</div>
        </div>
        {section.image && <img src={section.image} alt={section.imageAlt ?? ''} width="1536" height="1024" loading="lazy" />}
      </section>)}
    </div>
    {site.emailSignup?.enabled && site.emailSignup.formUrl && <section class="signup">
      <h2>{site.emailSignup.heading}</h2>
      <a class="text-link" href={site.emailSignup.formUrl}>{site.labels.signup}<span aria-hidden="true"> ↗</span></a>
    </section>}
  </main>
</Layout>
<style>
  .hero { display: grid; grid-template-columns: 1fr; padding: 3.5rem 5% 3rem; gap: 2.5rem; }
  .eyebrow { color: var(--accent); font-size: .9375rem; margin-bottom: 1.5rem; }
  h1 { font-size: clamp(3.4rem, 6.6vw, 7rem); line-height: 1.02; letter-spacing: -.055em; white-space: pre-line; margin: 0 0 2rem; }
  .intro { max-width: 25rem; }
  .intro p + p { font-size: 1rem; }
  .text-link { display: inline-block; margin-top: 1.2rem; padding-bottom: .5rem; border-bottom: 1px solid; text-decoration: none; font-size: 1rem; }
  .text-link span { margin-left: 1rem; }
  .hero-image { width: 100%; height: 100%; min-height: 320px; object-fit: cover; object-position: 44% center; }
  .sections { padding: 0 5%; scroll-margin-top: 2rem; }
  .section { padding: 3.5rem 0; border-top: 1px solid var(--line); }
  .section-number { font-size: .875rem; color: var(--accent); }
  h2 { font-size: clamp(2.5rem, 4.4vw, 4.5rem); line-height: 1.08; letter-spacing: -.04em; white-space: pre-line; margin: 1.25rem 0 2rem; }
  .section-body { max-width: 34rem; }
  .section img { width: 100%; aspect-ratio: 1.15; object-fit: cover; margin-top: 2rem; }
  .signup { padding: 3rem 5% 5rem; border-top: 1px solid var(--line); text-align: center; }
  @media (min-width: 800px) {
    .hero { grid-template-columns: 1fr 1.05fr; padding-block: 4rem 5rem; gap: 4%; align-items: stretch; }
    .hero-copy { padding-block: 2rem; }
    .hero-image { max-height: 720px; }
    .section { padding-block: 5rem; }
    .section:not(.has-image) .section-copy { display: grid; grid-template-columns: 1fr 1fr; column-gap: 7%; }
    .section:not(.has-image) h2 { grid-column: 1; }
    .section:not(.has-image) .section-body { grid-column: 2; grid-row: 2; padding-top: 1.25rem; }
    .has-image { display: grid; grid-template-columns: 1fr 1fr; gap: 7%; align-items: center; }
    .has-image img { margin: 0; }
    .reverse img { grid-column: 1; grid-row: 1; }
    .reverse .section-copy { grid-column: 2; grid-row: 1; }
  }
</style>
