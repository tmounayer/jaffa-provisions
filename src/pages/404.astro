---
import Layout from '../layouts/Layout.astro';
import { site } from '../content/site';
---
<Layout title={site.notFound.title} description={site.notFound.body} noindex>
  <main id="main"><h1>{site.notFound.headline}</h1><p>{site.notFound.body}</p><a href={site.links.home}>{site.labels.home}</a></main>
</Layout>
<style>
  main { padding: 5rem 5% 7rem; min-height: 60vh; max-width: 60rem; }
  h1 { font-size: clamp(3rem, 7vw, 6rem); line-height: 1.05; letter-spacing: -.045em; }
</style>
